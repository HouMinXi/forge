*.swp
*.swo
*~
.DS_Store
__pycache__/
*.egg-info/
dist/
build/
.coverage
.coverage.*

# Forge per-project runtime data (findings, review state)
# Ignore everything inside .forge/ except committed config (tools.yaml, gate.yaml)
.forge/*
!.forge/tools.yaml
!.forge/gate.yaml

# Virtual environments
.venv/

# Git worktrees
.worktrees/

# Planning and design docs (internal, not for distribution)
.planning/
docs/adr/

# AI assistant config and memory (NEVER commit)
.claude/
CLAUDE.md
*.jsonl

# Secrets and credentials
.env
.env.*
*.key
*.pem
*secret*
*token*
*credential*

# API config that may contain keys
aicc.conf
.aicc/

# Dogfood verification (local only, never commit)
dogfood/

# Model eval pilot data (contains surflare internal scripts). Anchored: an
# unanchored eval/ also matches tests/eval/, which is the tracked corpus.
/eval/

# code-forge runtime and receipts (local artifacts, not tracked)
.code-forge/
.code-forge/cache/
.worktrees/
REVIEW.md

# Mutation run leftovers. A completed run removes both, but a run that
# dies partway leaves them behind, and a stale mutants/ tree breaks the
# next pytest collection with a duplicate-conftest import error. The
# setup.cfg entry is safe only because this project keeps its config in
# pyproject.toml and never tracks a root setup.cfg of its own.
/mutants/
/setup.cfg

# Eval corpus is a build artefact: regenerated from SWE-bench Verified by
# code_forge.eval.build_corpus at a pinned seed, ~40MB of diffs and base
# files. The generator travels with the code; the output does not.
.eval-corpus/
