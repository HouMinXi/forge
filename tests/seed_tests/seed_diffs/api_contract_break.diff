def get_user(user_id):
    """Get user by ID. Returns user dict with profile data."""
    user = db.users.find_one({'_id': user_id})
    if not user:
        return {'error': 'not found'}, 404
    return {
        'id': str(user['_id']),
        'name': user['name'],
        'email': user['email'],
        'created_at': user['created_at'].isoformat(),
    }, 200
