import json
import os


class FileConverter:
    def __init__(self, logger=None):
        self.logger = logger

    def convert_single(self, input_path, output_path):
        """Convert a single CSV file to JSON."""
        try:
            with open(input_path, 'r') as f:
                data = f.read()
            parsed = json.loads(data)
            with open(output_path, 'w') as f:
                json.dump(parsed, f)
            return True
        except (IOError, json.JSONDecodeError) as exc:
            if self.logger:
                self.logger.error(f"Conversion failed: {exc}")
            return False
