src/data_processor.py
class DataProcessor:
    def __init__(self, db):
        self.db = db

    def _transform(self, record, related=None):
        return {'data': record, 'related': related}

    def process_records(self, source_id):
        """Process all records from a data source."""
        records = self.db.query(
            "SELECT * FROM records WHERE source_id = %s LIMIT 1000",
            (source_id,),
        )
        return [self._transform(r) for r in records]
