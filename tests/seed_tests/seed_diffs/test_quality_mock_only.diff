import unittest
from unittest.mock import MagicMock

from payment import PaymentProcessor


class TestPaymentProcessor(unittest.TestCase):
    def test_init(self):
        processor = PaymentProcessor(gateway=MagicMock())
        self.assertIsNotNone(processor)
