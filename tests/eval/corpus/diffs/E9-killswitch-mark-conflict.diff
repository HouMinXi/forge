+def activate_killswitch():
+    """Block all non-VPN egress traffic via nftables mark."""
+    subprocess.run(
+        ["nft", "add", "rule", "inet", "filter", "output",
+         "mark", "set", MARK_BLOCK, "accept"],
+        check=True,
+    )
+    check_vpn_health()
+
+
+def check_vpn_health():
+    """Probe VPN endpoint to confirm connectivity."""
+    subprocess.run(["curl", "-s", "--max-time", "5",
+                     "https://vpn.example.com/health"], check=True)
