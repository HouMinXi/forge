+        assert not any(a["file"] == "<llm-invoke>" for a in c1p1["anchors"])
+
+    def test_backend_failure_inside_the_attested_window_is_refused(
+        self, tmp_path
+    ):
+        """The same failure in an attested cycle must still be refused.
