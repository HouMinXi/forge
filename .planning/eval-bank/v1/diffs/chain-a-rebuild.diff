+            "@@ -1,2 +1,3 @@\n"
+            " x = 1\n"
+            "+y = 2\n"
+            " z = 3\n"
+        )
+        diff_sha = "abc123"
+        excerpts = [
+            {"file": "foo.py", "start_line": 1, "end_line": 3,
+             "content": "x = 1\ny = 2\nz = 3"},
+        ]
+        with caplog.at_level(logging.WARNING, logger="code_forge.receipt"):
+            write_receipts(
+                receipts_dir=tmp_path / "r",
+                round_index=0,
+                l1_findings=[],
